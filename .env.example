# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=            # from @BotFather
MY_TELEGRAM_ID=                # your numeric Telegram user id (the owner)
GEMINI_API_KEY=                # Google AI Studio key (free tier is enough)
COURSE_DIR=                    # folder with your course files, e.g. D:\Courses
WIKI_DIR=                      # optional: Obsidian vault folder
AGENT_ROOT=                    # optional: working folder for approved commands (default: the drive the bot lives on)
DRIVE_FOLDER_ID=               # optional: Google Drive folder for uploads
OPENROUTER_API_KEY=            # optional fallback for /conspect
OPENROUTER_MODEL=
FIND_SKIP_DIRS=                # optional: top-level folders of the drive to leave out of the file-name index, comma separated
GITHUB_TOKEN=                  # optional: raises the GitHub API limit for /nghiencuu from 60 to 5000 requests/hour (a free read-only token is enough)
TRUSTED_LOGIN=1                # 0 = logged-in friends may not use Drive or /agent
YT_CHANNELS=                   # optional: YouTube channel handles for the daily 10:00 stats, comma separated
YT_VAULT=                      # optional: folder of a YouTube-chapters vault the /nghiencuu gatekeeper reads (read-only)
APP705_DIR=                    # optional: folder of the 705bot shop app, for /hoadon
